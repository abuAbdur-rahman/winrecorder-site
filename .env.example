# Used by the release workflow and the app's updater.
# Generate with: openssl rand -hex 32   (or: node -e "console.log(crypto.randomUUID())")
RELEASE_TOKEN=

# Created automatically when a Vercel Blob store is linked to the project.
BLOB_READ_WRITE_TOKEN=

# Public origin, used for absolute URLs in the updater manifest.
NEXT_PUBLIC_SITE_URL=https://winrecorder-site.vercel.app
